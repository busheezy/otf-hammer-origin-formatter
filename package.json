{
  "name": "otf-hammer-origin-formatter",
  "displayName": "OTF Hammer Origin Formatter",
  "version": "0.0.1",
  "description": "Formats Hammer origin values when pasted into .vsndevts files.",
  "categories": [
    "Other"
  ],
  "publisher": "busheezy",
  "main": "./out/extension.js",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "typecheck": "tsc --noEmit",
    "check-all": "oxlint --fix && oxfmt && tsc --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.6.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^5.9.2"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.101.0"
  }
}
